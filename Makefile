# Rail-Intell -- reproduction targets.
#
# Every number in the paper is produced by one of these. If a figure or a table
# cannot be regenerated by `make`, it does not go in the paper.

PY := python3
G3 := 03_graph_construction
PUB := publication

.PHONY: all help build validate sweep metrics attributes service figures v11 geometry topology exports v12 v12audit servicelayer v14 v141 osm-c1 osm-c2 osm-c3 osm-release repairs freeze clean

help:
	@echo "Rail-Intell reproduction targets"
	@echo ""
	@echo "  make build       verify invariants and rebuild equivalence (E-001, E-002)"
	@echo "  make metrics     structural baselines, criticality, resilience (E-100)"
	@echo "  make validate    the validation battery (E-101)"
	@echo "  make sweep       construction-choice sensitivity study (E-200)"
	@echo "  make attributes  attribute provenance audit (E-300)"
	@echo "  make service     service-layer capacity audit (E-301)"
	@echo "  make v11         build/validate/export graph v1.1 provenance layer (E-400)"
	@echo "  make geometry    audit the released edge geometry, needs v11 (E-402)"
	@echo "  make topology    inspect components, high-degree nodes, dissolvables (E-403)"
	@echo "  make exports     re-export graph v1.0 and verify every attribute vs the Phase 2 CSVs"
	@echo "  make v12         graph v1.2: the five known weaknesses fixed where provable (E-500)"
	@echo "  make v12audit    v1.2 audit: removal robustness + timetable proof, conclusions (E-501)"
	@echo "  make servicelayer directed, timed service layer mapped to the physical graph (E-502)"
	@echo "  make derivation  length-derivation sensitivity, closes W7 (E-401)"
	@echo "  make figures     regenerate every paper figure (g06)"
	@echo "  make repairs     derive the repair decisions from evidence (E-702..E-706)"
	@echo "  make v14         build + gate + freeze graph v1.4 from those decisions (E-708, ~1m)"
	@echo "  make osm-c1      OpenStreetMap O1-O3: filter, collapse tracks, snap stations (E-716, ~45s)"
	@echo "  make osm-c2      OpenStreetMap O3b-O6: stations, joins, station graph, 2024 service (E-716, ~2m)"
	@echo "  make osm-c3      validate v2.0 against v1.4.1 and the outside references (E-716, ~1m)"
	@echo "  make v141        graph v1.4.1 working build: v1.4 + closure-audit fixes (E-717, ~1m)"
	@echo "  make freeze      full chain, then re-export and check the manifest (g07)"
	@echo "  make all         everything except freeze"
	@echo ""
	@echo "Runtime: build ~1m, metrics ~8m, sweep ~25m, v11 ~1m, geometry/topology ~15s, derivation ~17m, figures ~1m."

all: build metrics validate sweep attributes service v11 geometry topology v12 v12audit servicelayer derivation figures

build:
	$(PY) $(G3)/experiments/E-001/g00_verify.py
	$(PY) $(G3)/experiments/E-002/run.py

metrics:
	$(PY) $(G3)/experiments/E-100/run.py

validate:
	$(PY) $(G3)/experiments/E-101/run.py

sweep:
	$(PY) $(G3)/experiments/E-200/run.py

attributes:
	$(PY) $(PUB)/evidence/E-300_attribute_audit/run.py

service:
	$(PY) $(PUB)/evidence/E-301_service_layer_audit/run.py

figures:
	$(PY) $(PUB)/figures/make_figures.py

# v1.1 -- the provenance layer (D-025/026/027/029/030). Additive: topology is
# identical to v1.0 and the frozen graph_v1/ is never touched.
v11:
	$(PY) $(G3)/experiments/E-400_v1_1_build/run.py

# W1 -- independent audit of the geometry v11 just wrote (reads files only).
geometry:
	$(PY) $(G3)/experiments/E-402_alignment_audit/run.py

# Phase 3 plan item 5 -- read-only inspection, topology is never changed.
topology:
	$(PY) $(G3)/experiments/E-403_topology_cases/run.py

# D-039 -- every attribute of every node/edge survives every format, and the
# release carries every column and value of the Phase 2 CSVs.
exports:
	cd $(G3) && $(PY) -c "import json; from railgraph import io, load_graph; g = load_graph(); io.export_all(g); r = io.verify_roundtrip(g); s = io.verify_against_shipped(); print(json.dumps({'roundtrip_ok': r['all_roundtrip_ok'], 'complete_vs_phase2_csvs': s['complete']}, indent=2)); raise SystemExit(0 if r['all_roundtrip_ok'] and s['complete'] else 1)"

# v1.2 -- removes 51 provably duplicated stitch edges and adds edge-level
# attributes, validated speed imputation and state inference. Reads v1.1.
v12: v11
	$(PY) $(G3)/experiments/E-500_v1_2_build/run.py

# two parts so each stays under the session's 3-minute command limit
v12audit:
	$(PY) $(G3)/experiments/E-501_v1_2_audit/run.py --part A
	$(PY) $(G3)/experiments/E-501_v1_2_audit/run.py --part B

servicelayer:
	$(PY) $(G3)/experiments/E-502_service_layer/run.py

# W7 -- length derivation as a sensitivity factor. Resumable: each invocation
# does ~150s of cells and appends, so re-run until it reports COMPLETE.
derivation:
	$(PY) $(G3)/experiments/E-401_derivation_sweep/run.py

# Re-export the artifact and confirm the manifest reproduces. A build is frozen
# when this target is clean on a fresh checkout.
freeze: all
	$(PY) -c "from railgraph import io; r = io.export_all(); print('exported to', r['out_dir'])"
	$(PY) -c "from railgraph import io, build; \
	          g = build.load_graph(); \
	          import json; print(json.dumps(io.verify_roundtrip(g), indent=2, default=str))"
	@echo ""
	@echo "Now check graph_v1.manifest.json output hashes against the released ones."

clean:
	rm -rf $(G3)/experiments/cache
	@echo "cleared the metric cache; experiment outputs are left in place"

v13:
	cd 03_graph_construction/experiments/E-600_v1_3_build && python3 run.py s2a && python3 run.py s1 && \
	for p in 0 1 2 3; do python3 run.py s2b $$p 4; done && python3 run.py stage3 && python3 run.py stage4 && \
	python3 run.py stage5s open && python3 run.py stage5s full && python3 run.py stage5 && python3 run.py stage5g && \
	python3 run.py stage5b && python3 run.py stage5c && python3 run.py stage6
	P=$$(pwd)/03_graph_construction; for v in open full; do \
	  E502_GRAPH=$$P/graph_v1_3/$$v E502_OUT=$$P/service_layer_v1_3/$$v python3 $$P/experiments/E-502_service_layer/run.py > /dev/null; done
	cd 03_graph_construction/experiments/E-601_v1_3_conclusions && python3 run.py open && python3 run.py full && python3 run.py report
	cd 03_graph_construction/experiments/E-600_v1_3_build && python3 run.py stage_manifest

# ---------------------------------------------------------------- graph v1.4
# Two layers, deliberately separate. `repairs` DERIVES what to fix from the evidence
# and writes decision tables; it is slow and reviewable. `v14` APPLIES those decisions
# to v1.3, gates the result and freezes it; it is deterministic and reproduces every
# output hash. Analysis only ever needs `v14`.
A4 := 04_analysis_modules

repairs:
	$(PY) $(A4)/E-702_station_code_crosswalk/build_crosswalk.py . $(A4)/E-702_station_code_crosswalk/out
	$(PY) $(A4)/E-702_station_code_crosswalk/verify.py . $(A4)/E-702_station_code_crosswalk/out $(A4)/E-702_station_code_crosswalk/out
	$(PY) $(A4)/E-703_trunk_wiring/detect.py . $(A4)/E-703_trunk_wiring/out
	$(PY) $(A4)/E-703_trunk_wiring/repair.py . $(A4)/E-703_trunk_wiring/out $(A4)/E-703_trunk_wiring/out
	$(PY) $(A4)/E-703_trunk_wiring/verify.py . $(A4)/E-703_trunk_wiring/out $(A4)/E-703_trunk_wiring/out
	$(PY) $(A4)/E-703_trunk_wiring/finalize.py $(A4)/E-703_trunk_wiring/out $(A4)/E-703_trunk_wiring/out
	$(PY) $(A4)/E-704_missing_links/g6.py . $(A4)/E-703_trunk_wiring/out $(A4)/E-704_missing_links/out
	$(PY) $(A4)/E-705_service_layer_2024/build_service_2024.py . $(A4)/E-705_service_layer_2024/out
	$(PY) $(A4)/E-705_service_layer_2024/audit_added_edges.py . $(A4)/E-705_service_layer_2024/out
	$(PY) $(A4)/E-706_trains_per_day/trains_per_day.py . $(A4)/E-705_service_layer_2024/out $(A4)/E-706_trains_per_day/out

# Build, gate and freeze. Fails loudly if any gate is not met.
v14:
	$(PY) $(G3)/experiments/E-708_v1_4_build/run.py

# graph v1.4.1, working build (E-717). Milestone A1: attribute fixes; frozen at A3.
v141:
	$(PY) $(G3)/experiments/E-717_v1_4_1_build/run.py

# graph v2.0-open from OpenStreetMap (E-716, D-060). Milestone C1: stages O1-O3.
osm-c1:
	$(PY) $(G3)/experiments/E-716_osm_v2_build/run_c1.py

# Milestone C2: stages O3b, O5, O4, O6 (runs C1 in memory first; ~2 min, ~2.6 GB).
osm-c2:
	$(PY) $(G3)/experiments/E-716_osm_v2_build/run_c2.py --stage=c1
	$(PY) $(G3)/experiments/E-716_osm_v2_build/run_c2.py --stage=joins
	$(PY) $(G3)/experiments/E-716_osm_v2_build/run_c2.py --stage=graph
	$(PY) $(G3)/experiments/E-716_osm_v2_build/run_c2.py --stage=service

# Milestone C3: validate v2.0 against v1.4.1 and the outside references (~1 min).
osm-c3:
	$(PY) $(G3)/experiments/E-716_osm_v2_build/validate_c3.py

# Phase P3: package the open build as release v2.0-open-rc1 (deterministic zip, manifest, datasheet).
osm-release:
	$(PY) $(G3)/experiments/E-716_osm_v2_build/release.py

# Prove the release reproduces: rebuild and compare every output hash.
v14check:
	$(PY) -c "import json,shutil,pathlib; p=pathlib.Path('$(G3)/graph_v1_4/graph_v1_4.manifest.json'); shutil.copy(p,'/tmp/v14_before.json')"
	$(PY) $(G3)/experiments/E-708_v1_4_build/run.py > /dev/null
	$(PY) -c "import json; a=json.load(open('/tmp/v14_before.json'))['files']; b=json.load(open('$(G3)/graph_v1_4/graph_v1_4.manifest.json'))['files']; d=[k for k,v in a.items() if v['byte_reproducible'] and v['sha256']!=b.get(k,{}).get('sha256')]; print('reproducible: %d canonical files identical' % sum(1 for v in a.values() if v['byte_reproducible']) if not d else 'DIFFERS: '+str(d)); raise SystemExit(0 if not d else 1)"

# The audit of the released graph (E-707).
audit:
	$(PY) $(A4)/E-707_graph_audit/audit.py . $(A4)/E-707_graph_audit/out


# National severance criticality on the release (E-709). Stable-class metrics only.
sever:
	$(PY) $(A4)/E-709_severance_criticality/sever.py . $(A4)/E-709_severance_criticality/out
	$(PY) $(A4)/E-709_severance_criticality/corridors.py . $(A4)/E-709_severance_criticality/out

# The release contract (docs/STABILITY.md). Fails if the dataset has drifted.
test:
	$(PY) -m pytest tests -q

# The degree distribution as a fit test (E-710) and conclusion robustness (E-711).
degreefit:
	$(PY) $(A4)/E-710_degree_distribution/degree_fit.py . $(A4)/E-710_degree_distribution/out

robustness:
	$(PY) $(A4)/E-711_conclusion_robustness/sweep.py . $(A4)/E-711_conclusion_robustness/out

# Regenerate the release schema reference from the shipped files.
schema:
	$(PY) $(A4)/E-712_dataset_package/gen_schema.py . $(G3)/graph_v1_4
